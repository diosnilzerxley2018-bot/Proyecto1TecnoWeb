# Plantilla de configuración del frontend.
#
# Copiar como `.env.local` para desarrollo. En Vercel estas mismas claves se
# cargan desde el panel del proyecto (Settings -> Environment Variables), no
# desde un archivo.

# Dirección de la API, **terminada en /api**.
#
# En desarrollo apunta al backend local; en producción, al dominio que Railway
# asigne al backend. Es pública por definición —viaja al navegador, de ahí el
# prefijo NEXT_PUBLIC_—, así que aquí nunca va nada secreto.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
