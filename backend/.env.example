# Plantilla de configuración del backend.
#
# Copiar como `.env` y completar. **`.env` está en .gitignore y nunca se sube**:
# lleva la contraseña real de la base de datos.
#
# Para las pruebas hace falta además un `.env.test` con estas mismas claves,
# apuntando a la base `nutriexpress_test`, con NODE_ENV=test, BCRYPT_ROUNDS=4
# (para que la suite no tarde) y PAGO_SIMULADO_RETARDO_MS=0.

# ---- Base de datos (PostgreSQL) ----
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/nutriexpress?schema=public"

# ---- Servidor ----
PORT=4000
NODE_ENV=development

# ---- Seguridad (RNF-SEG) ----
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"
BCRYPT_ROUNDS=10

# Intentos fallidos antes de bloquear una cuenta (CU-SEG-05).
MAX_INTENTOS_FALLIDOS=3

# Minutos que dura el bloqueo antes de liberarse solo (hallazgo H8).
# En cero el bloqueo no caduca y solo lo levanta el administrador: es la
# configuración más estricta, y también la que puede dejar al sistema sin nadie
# capaz de reabrirlo si le toca al propio administrador.
MINUTOS_DE_BLOQUEO=15

# Límite de intentos por dirección IP, para frenar la fuerza bruta desde una
# misma conexión. Solo cuentan los intentos fallidos.
MAX_INTENTOS_POR_IP=20
VENTANA_INTENTOS_MS=900000

# ---- CORS: orígenes autorizados del frontend ----
#
# Lista separada por comas. En un despliegue en Vercel hay más de una
# dirección: el dominio de producción y uno por cada previsualización. Con un
# solo origen, las previsualizaciones quedan bloqueadas y parece un fallo del
# backend.
CORS_ORIGIN="http://localhost:3000"

# ---- Cobros en línea (RF-PED-04) ----
#
# El modo de cobro (Simulado / Real) **no se configura aquí**: vive en la tabla
# `configuracion` y lo cambia el administrador en caliente desde su perfil. Una
# variable de entorno obligaría a reiniciar el servidor para algo que debe
# poder cambiarse en cualquier momento.

# Cuánto tarda la pasarela simulada en confirmar un cobro. En las pruebas, 0.
PAGO_SIMULADO_RETARDO_MS=3000

# Minutos que un cobro pendiente reserva el stock antes de vencer.
PAGO_MINUTOS_EXPIRACION=30

# Dirección pública de esta API, a la que la pasarela envía sus avisos.
# En desarrollo hace falta un túnel (ngrok o similar) para que pueda alcanzarla.
PAGO_URL_PUBLICA="http://localhost:4000"

# Qué pasarela se usaría al activar el dinero real.
# La clave distingue mayúsculas (src/pagos/index.ts, REALES): tiene que ser
# exactamente "Libelula", no "libelula". Escrito en minúscula, el modo Real se
# rechaza con «No hay adaptador para la pasarela».
PAGO_PASARELA_REAL="Libelula"

# ---- Libélula (agregador de pagos boliviano) ----
# Solo hacen falta con el modo de cobro en Real.
LIBELULA_API_KEY=""
# El correo que se usa cuando la venta es a «Consumidor final» y no hay cliente
# de quien tomarlo. Libélula exige un correo en cada cobro y lo rechaza sin él.
LIBELULA_EMAIL_COMERCIO=""
# Pruebas: http://www.todotix.com:10888 · Producción: https://api.todotix.com
LIBELULA_URL_BASE="http://www.todotix.com:10888"

# ---- Correo saliente ----
#
# Tres modos:
#   simulado  guarda en memoria y no envía nada. Es el valor por omisión y el
#             que usan las pruebas.
#   smtp      entrega por un servidor SMTP. Es lo del laboratorio, contra el
#             Postfix de la VM.
#   brevo     entrega por la API HTTPS de Brevo. Es lo que hace falta en una
#             plataforma gestionada: Railway bloquea el puerto SMTP saliente en
#             sus planes Trial y Hobby, así que `smtp` no puede conectarse por
#             más bien configurado que esté.
CORREO_MODO="simulado"
CORREO_REMITENTE="NutriExpress <no-responder@nutriexpress.bo>"

# Con CORREO_MODO=smtp. Apuntando al Postfix local, el puerto es 25 y no hacen
# falta usuario ni contraseña: el propio servidor encola y reintenta.
CORREO_SERVIDOR="localhost"
CORREO_PUERTO=25
CORREO_USUARIO=""
CORREO_CONTRASENA=""

# Con CORREO_MODO=brevo. Se saca del panel de Brevo, en SMTP & API -> API Keys.
#
# Sin un dominio propio verificado, Brevo entrega igual a cualquier
# destinatario pero reescribe el remitente a `@brevosend.com`. Para una
# demostración es suficiente; para un remitente propio hay que verificar el
# dominio con los registros DKIM que Brevo indique.
BREVO_API_KEY=""
